# Configuration OdinLinuxTool — SamsungToolkitA7

# Chemin ADB (laisser vide si dans PATH)
adb_path=/usr/bin/adb

# Chemin Heimdall (laisser vide si dans PATH)
heimdall_path=/usr/bin/heimdall

# Options par défaut
auto_reboot=false
verbose=true

# Device cible
device=SM-A750FN
android_version=10
oneui_version=2.0
